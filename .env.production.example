# Production environment template for HVAC Services.
# Copy to .env on the server, fill in every value marked with <...>, then run: php artisan key:generate
# Never commit the filled-in file. See docs/04-DEPLOYMENT.md.

APP_NAME="HVAC Services"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<your-domain.com>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=<db-host>
DB_PORT=3306
DB_DATABASE=<db-name>
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log

# Required: lead alert emails and admin password resets.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS=<no-reply@your-domain.com>
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# First super admin, created once by: php artisan db:seed --class=CoreSeeder --force
# Leave ADMIN_PASSWORD empty to generate one, then set your own with: php artisan app:reset-password <email>
ADMIN_NAME="Site Administrator"
ADMIN_EMAIL=<admin@your-domain.com>
ADMIN_PASSWORD=

# Must stay false/empty in production (the app also forces demo login off when APP_ENV=production).
ADMIN_DEMO_LOGIN=false
DEMO_PASSWORD=

# Tracking: loads GTM, GA4, Google Ads and MarketCall scripts (IDs are managed in Admin → Settings).
ANALYTICS_ENABLED=true
LEAD_NOTIFICATION_EMAIL=<leads@your-domain.com>

# Comma-separated proxy IPs, or * only when behind a trusted CDN / load balancer such as Cloudflare.
TRUSTED_PROXIES=

MEDIA_VARIANTS=true
